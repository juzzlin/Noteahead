#!/bin/bash

# Builds a self-contained AppImage of Noteahead.
# Must be run in the project root.
#
# The AppImage is built against the distribution's own Qt on purpose. The
# official upstream Qt binaries for 6.8 and 6.9 are themselves built on Ubuntu
# 24.04 with glibc 2.39, so reaching for a newer Qt would raise the AppImage's
# glibc floor rather than lower it.

set -e

BUILD_DIR=${BUILD_DIR:-build-appimage}
APPDIR=${APPDIR:-AppDir}
TOOLS_DIR=${TOOLS_DIR:-.appimage-tools}
export ARCH=${ARCH:-$(uname -m)}

if [[ ! -f CMakeLists.txt ]]; then
    echo "$0: must be run in the project root"
    exit 1
fi

VERSION_MAJOR=$(sed -n 's/^set(VERSION_MAJOR \([0-9]*\))/\1/p' CMakeLists.txt)
VERSION_MINOR=$(sed -n 's/^set(VERSION_MINOR \([0-9]*\))/\1/p' CMakeLists.txt)
VERSION_PATCH=$(sed -n 's/^set(VERSION_PATCH \([0-9]*\))/\1/p' CMakeLists.txt)
VERSION="${VERSION_MAJOR}.${VERSION_MINOR}.${VERSION_PATCH}"
APPIMAGE="Noteahead-${VERSION}-${ARCH}.AppImage"

# Libraries that must come from the host rather than from the AppImage. A JACK
# client library has to match the server it talks to, so the bundled copy is
# only ever a fallback for hosts that have no JACK at all -- without it the
# binary would not even load there, JACK being linked directly.
FALLBACK_LIBRARIES=(
    libjack.so.0
)

# The GLib family is versioned as one unit and its util-linux dependencies come
# with it (gio -> mount -> blkid -> uuid). Bundling any of them next to newer
# host libraries that link GLib breaks those with unresolved symbols, so the
# host's copies must be used throughout.
SYSTEM_LIBRARIES=(
    libglib-2.0.so.0
    libgio-2.0.so.0
    libgobject-2.0.so.0
    libgmodule-2.0.so.0
    libgthread-2.0.so.0
    libmount.so.1
    libblkid.so.1
    libuuid.so.1
)

# Plugins that the Qt import scanner does not find on its own.
ADDITIONAL_QT_PLUGINS=(
    platformthemes/libqgtk3.so
    wayland-decoration-client
    wayland-graphics-integration-client
    wayland-shell-integration
)

echo "Building Noteahead ${VERSION} AppImage for ${ARCH} .."

##############################################################################
# Fetch the AppImage tooling
##############################################################################

mkdir -p "${TOOLS_DIR}"
TOOLS_DIR=$(cd "${TOOLS_DIR}" && pwd)

for tool in linuxdeploy linuxdeploy-plugin-qt appimagetool; do
    if [[ ! -x "${TOOLS_DIR}/${tool}" ]]; then
        case ${tool} in
            appimagetool) repo="AppImage/appimagetool" ;;
            *)            repo="linuxdeploy/${tool}" ;;
        esac
        echo "Downloading ${tool} .."
        curl -sSfL -o "${TOOLS_DIR}/${tool}.AppImage" \
            "https://github.com/${repo}/releases/download/continuous/${tool}-${ARCH}.AppImage"
        chmod +x "${TOOLS_DIR}/${tool}.AppImage"

        # Unpacked rather than kept as an AppImage. linuxdeploy starts its Qt
        # plugin itself and has no way to pass --appimage-extract-and-run on to
        # it, so the plugin would mount itself through FUSE -- which a container
        # does not have. Unpacked tools need no FUSE from anyone.
        rm -rf "${TOOLS_DIR}/${tool}.AppDir"
        (cd "${TOOLS_DIR}" && ./"${tool}.AppImage" --appimage-extract > /dev/null && mv squashfs-root "${tool}.AppDir")
        rm -f "${TOOLS_DIR}/${tool}.AppImage"

        # The wrapper resolves its own directory rather than baking one in, so
        # that a cached ${TOOLS_DIR} still works when the tree is mounted
        # somewhere else inside a container.
        cat > "${TOOLS_DIR}/${tool}" <<WRAPPER
#!/bin/sh
HERE="\$(dirname "\$(readlink -f "\$0")")"
exec "\${HERE}/${tool}.AppDir/AppRun" "\$@"
WRAPPER
        chmod +x "${TOOLS_DIR}/${tool}"
    fi
done

export PATH="${TOOLS_DIR}:${PATH}"

##############################################################################
# Build and install into the AppDir
##############################################################################

# A CMake cache records absolute paths, so a build directory configured on the
# host is unusable from inside a container and the other way round. The same
# working tree is used for both, so start over instead of failing.
if [[ -f "${BUILD_DIR}/CMakeCache.txt" ]]; then
    cached_source=$(sed -n 's/^CMAKE_HOME_DIRECTORY:INTERNAL=//p' "${BUILD_DIR}/CMakeCache.txt")
    if [[ ${cached_source} != "${PWD}" ]]; then
        echo "Discarding ${BUILD_DIR}, configured for ${cached_source} .."
        rm -rf "${BUILD_DIR}"
    fi
fi

cmake -B "${BUILD_DIR}" -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTS=OFF
cmake --build "${BUILD_DIR}"

rm -rf "${APPDIR}"
cmake --install "${BUILD_DIR}" --prefix "${APPDIR}/usr"

##############################################################################
# Bundle the dependencies
##############################################################################

QMAKE=${QMAKE:-$(command -v qmake6 || command -v qmake || true)}
if [[ -z ${QMAKE} ]]; then
    echo "$0: cannot find qmake6, install qt6-base-dev"
    exit 1
fi
export QMAKE
QT_PLUGIN_DIR=$("${QMAKE}" -query QT_INSTALL_PLUGINS)

# The QML lives in the binary's resources, so the import scanner has to be
# pointed at the sources instead.
export QML_SOURCES_PATHS="${PWD}/src/view/qml"

# Wayland is worth having but not worth failing over: without qt6-wayland the
# AppImage still runs everywhere through XWayland.
# Upstream Qt builds one libqwayland.so, Debian splits it into an EGL and a
# generic plugin, so take whatever is actually there.
EXTRA_PLATFORM_PLUGINS="libqoffscreen.so"
wayland_plugins=$(cd "${QT_PLUGIN_DIR}/platforms" 2> /dev/null && ls libqwayland*.so 2> /dev/null || true)
for plugin in ${wayland_plugins}; do
    EXTRA_PLATFORM_PLUGINS="${EXTRA_PLATFORM_PLUGINS};${plugin}"
done
if [[ -z ${wayland_plugins} ]]; then
    echo "Warning: no Wayland platform plugin found, the AppImage will be X11 only."
fi
export EXTRA_PLATFORM_PLUGINS

linuxdeploy \
    --appdir "${APPDIR}" \
    --desktop-file "${APPDIR}/usr/share/applications/noteahead.desktop" \
    --icon-file "${APPDIR}/usr/share/icons/hicolor/256x256/apps/noteahead.png" \
    --plugin qt

# Qt's own translations, for the strings Qt itself supplies (standard dialog buttons and the like).
# Noteahead's catalogues are embedded in the binary and need no deployment, but these live outside
# it, and linuxdeploy's Qt plugin does not bring them along. The qt.conf it writes sets Prefix to
# usr/, and Qt's default Translations path is 'translations' relative to that.
QT_TRANSLATIONS_DIR=$("${QMAKE}" -query QT_INSTALL_TRANSLATIONS)
if compgen -G "${QT_TRANSLATIONS_DIR}/qtbase_*.qm" > /dev/null; then
    mkdir -p "${APPDIR}/usr/translations"
    cp -L "${QT_TRANSLATIONS_DIR}"/qtbase_*.qm "${APPDIR}/usr/translations/"
    echo "Bundled $(ls "${APPDIR}/usr/translations" | wc -l) Qt translation catalogues."
else
    echo "Warning: no Qt translations found in ${QT_TRANSLATIONS_DIR}, install qt6-translations-l10n."
    echo "         Qt-supplied strings will stay in English in the AppImage."
fi

COPIED_QT_PLUGINS=()
for plugin in "${ADDITIONAL_QT_PLUGINS[@]}"; do
    if [[ -e "${QT_PLUGIN_DIR}/${plugin}" ]]; then
        mkdir -p "${APPDIR}/usr/plugins/$(dirname "${plugin}")"
        cp -Lr "${QT_PLUGIN_DIR}/${plugin}" "${APPDIR}/usr/plugins/${plugin}"
        COPIED_QT_PLUGINS+=("${APPDIR}/usr/plugins/${plugin}")
    else
        echo "Warning: Qt plugin ${plugin} not found, skipping."
    fi
done

# linuxdeploy rewrites the runpath of everything it deploys itself. The plugins above are copied in
# behind its back and get none at all, so they cannot see the Qt libraries sitting right there in
# usr/lib. Nothing complained for as long as the machine running the AppImage happened to have its
# own Qt to fall back on; on one without, the Wayland EGL integration failed to load and Qt Quick
# was then left with no GL context and aborted at startup.
#
# Every plugin sits one directory below usr/plugins, so usr/lib is two up -- the same runpath
# linuxdeploy writes. patchelf comes out of linuxdeploy's own AppDir, so this needs nothing
# installed that the build did not already fetch.
PATCHELF="${TOOLS_DIR}/linuxdeploy.AppDir/usr/bin/patchelf"
if [[ ! -x ${PATCHELF} ]]; then
    PATCHELF=$(command -v patchelf || true)
fi
if [[ -z ${PATCHELF} ]]; then
    echo "$0: cannot find patchelf to set the plugin runpaths"
    exit 1
fi

for plugin in "${COPIED_QT_PLUGINS[@]}"; do
    while IFS= read -r -d '' library; do
        "${PATCHELF}" --set-rpath '$ORIGIN/../../lib:$ORIGIN' "${library}" || exit 1
    done < <(find "${plugin}" -name '*.so' -type f -print0)
done

for library in "${SYSTEM_LIBRARIES[@]}"; do
    rm -f "${APPDIR}/usr/lib/${library}"
done

for library in "${FALLBACK_LIBRARIES[@]}"; do
    path=$(ldconfig -p | sed -n "s/^[[:space:]]*${library} .* => //p" | head -1)
    if [[ -z ${path} ]]; then
        echo "$0: cannot find ${library} to bundle as a fallback"
        exit 1
    fi
    mkdir -p "${APPDIR}/fallback/${library}"
    cp -L "${path}" "${APPDIR}/fallback/${library}/${library}"
    rm -f "${APPDIR}/usr/lib/${library}"
done

##############################################################################
# Entry point
##############################################################################

rm -f "${APPDIR}/AppRun"
cat > "${APPDIR}/AppRun" <<'APPRUN'
#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="${APPDIR:-$HERE}"

# Fallback libraries are bundled but deliberately kept off the library path, so
# that the host's own copy wins whenever it has one. We only step in when the
# host has none at all, which would otherwise stop the binary from loading. The
# bundled lib directory goes on the path alongside them: a fallback carries no
# RUNPATH of its own and its dependencies may be missing from the host too --
# JACK needs libdb, which Fedora no longer ships.
fallback_paths=""
for dir in "$HERE"/fallback/*; do
    [ -d "$dir" ] || continue
    lib="$(basename "$dir")"
    if ! ldconfig -p 2>/dev/null | grep -q "^[[:space:]]*${lib} "; then
        fallback_paths="${fallback_paths}${dir}:"
    fi
done
if [ -n "$fallback_paths" ]; then
    LD_LIBRARY_PATH="${fallback_paths}${HERE}/usr/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    export LD_LIBRARY_PATH
fi

exec "$HERE/usr/bin/noteahead" "$@"
APPRUN
chmod +x "${APPDIR}/AppRun"

##############################################################################
# Pack it
##############################################################################

rm -f "${APPIMAGE}"
appimagetool --no-appstream "${APPDIR}" "${APPIMAGE}"

echo "Created ${APPIMAGE}"
