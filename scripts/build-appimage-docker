#!/bin/bash

# Runs scripts/build-appimage inside a stock Ubuntu container.
# Must be run in the project root.
#
# An AppImage only runs on a glibc at least as new as the one it was built
# against, so the build environment decides how portable the result is. Building
# on the host would tie the AppImage to whatever the host happens to be, and
# would quietly make it less portable the moment the host is upgraded. The
# container pins it to the oldest release we target instead.
#
# The image is stock Ubuntu rather than one of our own: nothing here needs to be
# prebuilt, and a stock image cannot drift away from what the AppImage is meant
# to be built against.

set -e

IMAGE=${IMAGE:-ubuntu:24.04}

if [[ ! -f CMakeLists.txt ]]; then
    echo "$0: must be run in the project root"
    exit 1
fi

if ! command -v docker > /dev/null; then
    echo "$0: docker is not installed"
    exit 1
fi

PACKAGES=(
    build-essential
    cmake
    curl
    file
    ninja-build
    pkg-config
    libjack-jackd2-dev
    librtaudio-dev
    librtmidi-dev
    libsndfile1-dev
    qt6-base-dev
    qt6-declarative-dev
    qt6-gtk-platformtheme
    qt6-tools-dev
    qt6-wayland

    # Needed as runtime files rather than to build against: these are the QML
    # modules that get copied into the AppDir. The -dev packages above do not
    # bring them in.
    qml6-module-qtcore
    qml6-module-qtqml
    qml6-module-qtqml-workerscript
    qml6-module-qtquick
    qml6-module-qtquick-controls
    qml6-module-qtquick-dialogs
    qml6-module-qtquick-layouts
    qml6-module-qtquick-templates
    qml6-module-qtquick-window
)

echo "Building the AppImage in ${IMAGE} .."

docker run --rm -i \
    -v "${PWD}:/noteahead" \
    -w /noteahead \
    -e DEBIAN_FRONTEND=noninteractive \
    -e PACKAGES="${PACKAGES[*]}" \
    -e HOST_UID="$(id -u)" \
    -e HOST_GID="$(id -g)" \
    "${IMAGE}" bash -e -s <<'IN_CONTAINER'
# The container builds as root, so everything it created in the mounted working
# tree has to be handed back or the caller cannot clean up after it. On a trap,
# because a failed build leaves just as much behind as a successful one -- and a
# workspace nobody can delete is worse than a build that merely failed.
hand_back() {
    for path in Noteahead-*.AppImage build-appimage AppDir .appimage-tools; do
        if [ -e "${path}" ]; then
            chown -R "${HOST_UID}:${HOST_GID}" "${path}"
        fi
    done
}
trap hand_back EXIT

apt-get update -qq
apt-get install -y -qq ${PACKAGES}

./scripts/build-appimage
IN_CONTAINER
